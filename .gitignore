# Trained models & checkpoints (regenerated by the pipeline; large)
**/*.pt
medvae/results/
baselines/fitted_models/

# Large preview rasters — keep the vector .eps/.pdf
**/*.png

# Python / runtime
__pycache__/
*.pyc
*.out
*.log
# SLURM logs; logs/ itself is kept (via .gitkeep) because the job scripts write there
logs/*
!logs/.gitkeep
.ipynb_checkpoints/

# Local, uncommitted site overrides (map the generic names to your files; picked up
# by ccn_config.py and scripts/_env.sh if present). Create them yourself; never commit them.
ccn_config_local.py
scripts/_env.local.sh

# Scratch / extra result dirs
results_*/
*_validate*/
*_sanity*/
# Aux metric dumps written by the fit/eval helpers (not figure inputs)
baselines/results/
baselines/ccn_results_evaluation/
